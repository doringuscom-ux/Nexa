<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force non-www so Google sees only one version of every page (http->https is already done by the host)
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://nexainfotech.com/$1 [R=301,L]

  # Remove trailing slash (/about/ -> /about) to avoid duplicate URLs
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]
  
  # Internally route sitemap requests to PHP proxy scripts
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^sitemap\.xsl$ sitemap_xsl.php [L]

  RewriteRule ^index\.html$ - [L]
  
  # Redirect favicon.ico to our square favicon to avoid 404s and meet Google requirements
  RewriteRule ^favicon\.ico$ /favicon.png [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

# Prevent directory listing
Options -Indexes

# Set the default 404 to index.html as a fallback
ErrorDocument 404 /index.html

